PORT=3000
NODE_ENV=development

# 数据库(MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=ssda

# JWT(必填,至少 16 字符;缺失或过短时服务拒绝启动,生产/演示环境务必更换)
JWT_SECRET=please-change-this-secret-at-least-16-chars
JWT_EXPIRES_IN=12h

# CORS 白名单(逗号分隔多个 origin;默认放行本地前端开发地址)
CORS_ORIGIN=http://localhost:5173

# AI 生成(DeepSeek,OpenAI 兼容协议;不配置 Key 时 AI 对话自动降级为本地检索模板回答)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_MS=20000

# 外部知识库(可选;不配置时使用本地 Mock 检索器)
KB_API_BASE_URL=
